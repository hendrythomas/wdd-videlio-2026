---
//@ts-nocheck
import MainLayout from '../../../layouts/MainLayout.astro';
import { decodeHtml } from '../../../utils/decodeHtml.js'

const res = await fetch('http://dev1.videlio.nl/wp-json/wp/v2/radio-aflevering?acf_format=standard');
const data = await res.json();

const radios = data.map(radio => {
    return {
        id: radio.id,
        title: decodeHtml(radio.title.rendered),
        image: radio.acf.thumbnail,
        url: radio.acf.radio_url,
        date: radio.acf.datum
    }
})

---

<MainLayout title="Radio afleveringen" backHref="/Verhalen-Media" >
    <section class="project-section">
        <h1>Radio uitzendingen</h1>
        <div class="grid-projects">
            {
                radios.map(radio => (
                    <div class="project-card">
                        <div class="image">
                            <a target="_blank" href={radio.url}>
                                <img src={radio.image}>
                                <h4>{radio.title}</h4>
                                <p></p>
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>
    </section>
</MainLayout>

<style>
    .project-section {
        min-height: 100vh;
    }

    .project-section h1 {
        color: var(--highlight-color);
        margin-bottom: 40px;
    }

    .grid-projects {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
    }

    .project-card {
        width: 15em;
        justify-self: center;
    }

    .project-card img {
        height: 20em;
        aspect-ratio: 1/1;
        border-radius: 10px;
        display: block;
        object-fit: cover;
    }

    .project-card h4 {
        color: var(--highlight-color);
        margin-top: 15px;
        font-size: 2rem;
        text-decoration: none;
    }

</style>