---
//@ts-nocheck
import MainLayout from '../../../layouts/MainLayout.astro';
// import './podcasts.css';
---

<MainLayout title="Podcasts">
    <section class="project-section">
        <h1>Podcasts</h1>
            <!--Podcasts John Willemse-->
            <div class="grid-projects">
                <!--Podcast John-->
                        <div class="project-card">
                            <div class="image">
                                <a href="./Podcasts/john">
                                    <img src="../assets/images/decoratie/john.png">
                                    <h4>John Willemse</h4>
                                </a>
                            </div>
                        </div>
                        
                        <!--Podcast Niet te zien -->
                        <div class="project-card">
                            <a href="./Podcasts/niet_te_zien">
                                <img src="../assets/images/decoratie/niet_te_zien.png">
                                <h4>Niet te zien</h4>
                            </a>
                        </div>
                    </div>
            </section>
</MainLayout>

<style>
    .project-section {
        padding: 80px;
        min-height: 100vh;
    }

    .project-section h1 {
        color: var(--highlight-color);
        margin-bottom: 40px;
    }

    .grid-projects {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        column-gap: 250px;
        max-width: 800px;
    }

    .project-card {
        width: 400px;
    }

    .project-card img {
        width: 100%;
        border-radius: 10px;
        display: block;
    }

    .project-card h4 {
        color: var(--highlight-color);
        margin-top: 15px;
        font-size: 2rem;
        text-decoration: none;
    }

</style>