---
import MainLayout from '../../../layouts/MainLayout.astro';
import './podcasts.css';
---

<MainLayout>
    <section class="project-section">
        <h1>Podcasts</h1>

        <h2 class="name-podcast">John Willemse</h2>

        <main>
            <section class="grid-projects">
                <div class="project-card">
                    <a href="https://videlio.nl/wp-content/uploads/2026/01/AUDIO-2025-12-05-10-14-18.mp3">
                        <img src="/assets/images/decoratie/john.png">
                    </a>

                    <div class="podcast-info">
                        <h4>Nr 1. Introductie podcast</h4>
                    </div>
                </div>

                <div class="project-card">
                    <a href="https://videlio.nl/wp-content/uploads/2026/01/AUDIO-2025-12-05-10-23-57.mp3">
                        <img src="/assets/images/decoratie/john.png">
                    </a>

                    <div class="podcast-info">
                        <h4>Nr 2. De samenleving heeft een handicap. Niet ik!</h4>
                    </div>
                </div>

                <div class="project-card">
                    <a href="https://videlio.nl/wp-content/uploads/2026/01/AUDIO-2025-12-05-10-28-22.mp3">
                        <img src="/assets/images/decoratie/john.png">
                    </a>

                    <div class="podcast-info">
                        <h4>Nr 3. De cijfers, achtergronden en oplossingen</h4>
                    </div>
                </div>
            </section>

            <section class="grid-projects">
                <div class="project-card">
                    <a href="">
                        <img src="/assets/images/decoratie/niet_te_zien.png">
                    </a>

                    <div class="podcast-info">
                        <h4>1. Is dit creatief plannen, of toch gewoon uitstel gedrag?</h4>
                    </div>
                </div>
            </section>
        </main>
    </section>
</MainLayout>