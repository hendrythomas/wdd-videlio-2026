---
//@ts-nocheck
import MainLayout from '../../../layouts/MainLayout.astro';
// import './podcasts.css';

const res = await fetch('http://dev1.videlio.nl/wp-json/wp/v2/podcast?acf_format=standard');
const data = await res.json();

const podcasts = data.map(podcast => {
    return {
        id: podcast.id,
        title: podcast.name,
        image: podcast.acf.image
    }
})

console.log(podcasts);
---

<MainLayout title="Podcasts" backHref="/">
    <section class="project-section">
        <h1>Podcasts</h1>
            <!--Podcasts John Willemse-->
            <div class="grid-projects">
                {
                    podcasts.map(podcast => (
                        <div class="project-card">
                            <div class="image">
                                <a href=`./Podcasts/${podcast.id}`>
                                    <img src={podcast.image}>
                                    <h4>{podcast.title}</h4>
                                </a>
                            </div>
                        </div>
                    ))
                }
            </div>
            </section>
</MainLayout>

<style>
    .project-section {
        min-height: 100vh;
    }

    .project-section h1 {
        color: var(--highlight-color);
        margin-bottom: 40px;
    }

    .grid-projects {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 1rem;
        align-items: center;
        justify-content: center;
    }

    .project-card {
        width: fit-content;
        justify-self: center;
    }

    .project-card img {
        height: 20em;
        aspect-ratio: 1/1;
        border-radius: 10px;
        display: block;
        object-fit: cover;
    }

    .project-card h4 {
        color: var(--highlight-color);
        margin-top: 15px;
        font-size: 2rem;
        text-decoration: none;
    }

</style>