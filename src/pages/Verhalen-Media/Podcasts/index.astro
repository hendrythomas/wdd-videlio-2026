<style>
    .grid-projects {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .extra-podcast {
        display: none;
    }

    .grid-projects.expanded .extra-podcast {
        display: block;
    }

    a {
        color: var(--highlight-color);
        text-decoration: none;
    }
</style>

<script>
    //@ts-nocheck
    //openen en sluiten meer zien
    const readMore = document.querySelector('.read-more');
    const grid = document.querySelector('.grid-projects');

    readMore.addEventListener('click', (e) => {
        e.preventDefault();
        grid.classList.toggle('expanded');

        if
        (grid.classList.contains('expanded')) {
            readMore.textContent = 'Luister minder';
        } else {
            readMore.textContent = 'Luister meer';
        }
    })

    //playbuttons
    const button1 = document.getElementById('button1');
    const button2 = document.getElementById('button2');
    const button3 = document.getElementById('button3');
    const button4 = document.getElementById('button4');
    const button5 = document.getElementById('button5');
    const button6 = document.getElementById('button6');
    const button7 = document.getElementById('button7');
    const button8 = document.getElementById('button8');
    const button9 = document.getElementById('button9');
    const button10 = document.getElementById('button10');
    const button11 = document.getElementById('button11');
    const button12 = document.getElementById('button12');
    const button13 = document.getElementById('button13');
    const button14 = document.getElementById('button14');
    const button15 = document.getElementById('button15');
    const button16 = document.getElementById('button16');

    function toggleAudio(event, audioId, progressId) {
        const button = event.target;

        const audio = document.getElementById(audioId);
        const progress = document.getElementById(progressId);

        //Play en pause
        if (audio.paused) {
            audio.play();
            button.innerHTML = "▶";
        } else {
            audio.pause();
            button.innerHTML = "▶";
        }

        //Slider werkt zodra metadata geladen is
        audio.addEventListener("loadedmetadata", () => {
            progress.max = audio.duration;
        });

        //Slider beweegt mee
        audio.addEventListener("timeupdate", () => {
            progress.value = audio.currentTime;
        });

        //Zelf door of terug kunnen spoelen
        progress.addEventListener("input", () => {
            audio.currentTime = progress.value;
        });

        //Als de audio klaar is
        audio.addEventListener("ended", () => {
            button.innerHTML = "▶";
            progress.value = 0;
        });
    }

    button1.addEventListener("click", (event) => { toggleAudio(event, 'audio1', 'progress1') });
    button2.addEventListener("click", (event) => { toggleAudio(event, 'audio2', 'progress2') });
    button3.addEventListener("click", (event) => { toggleAudio(event, 'audio3', 'progress3') });
    button4.addEventListener('click', (event) => { toggleAudio(event, 'audio4', 'progress4') });
    button5.addEventListener('click', (event) => { toggleAudio(event, 'audio5', 'progress5') });
    button6.addEventListener('click', (event) => { toggleAudio(event, 'audio6', 'progress6') });
    button7.addEventListener('click', (event) => { toggleAudio(event, 'audio7', 'progress7') });
    button8.addEventListener('click', (event) => { toggleAudio(event, 'audio8', 'progress8') });
    button9.addEventListener('click', (event) => { toggleAudio(event, 'audio9', 'progress9') });
    button10.addEventListener('click', (event) => { toggleAudio(event, 'audio10', 'progress10') });
    button11.addEventListener('click', (event) => { toggleAudio(event, 'audio11', 'progress11') });
    button12.addEventListener('click', (event) => { toggleAudio(event, 'audio12', 'progress12') });
    button13.addEventListener('click', (event) => { toggleAudio(event, 'audio13', 'progress13') });
    button14.addEventListener('click', (event) => { toggleAudio(event, 'audio14', 'progress14') });
    button15.addEventListener('click', (event) => { toggleAudio(event, 'audio15', 'progress15') });
    button16.addEventListener('click', (event) => { toggleAudio(event, 'audio16', 'progress16') });
</script>