<style>
    .project-section {
        padding: 30px;
    }

    .project-section h1 {
        color: var(--highlight-color);
    }

    .podcast-page {
        display: flex;
        gap: 40px;
        padding: 30px;
    }

    .audio {
        width: 450px;
    }

    img {
        border-radius: 10px;
    }

    h4 {
        color: var(--highlight-color);
    }

    .main-img {
        width: 100%;
    }

    .control-buttons {
        margin-top: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .control-buttons button {
        border-radius: 50%;
        height: 40px;
        width: 40px;
        border: none;
        font-size: 18px;
    }

    #progress {
        flex: 1;
    }

    .playlist-container {
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    .playlist {
        overflow-y: scroll;
        height: 400px;
        padding: 10px;
    }

    .podcast {
        display: flex;
        justify-content: space-between;
        align-items: center;

        border: 2px solid gray;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 15px;
    }

    .podcast button {
        border-radius: 50%;
        border: none;
        height: 30px;
        width: 30px;
        font-size: 15px;
    }

    .podcast:hover {
        border-color: var(--highlight-color);
    }
</style>

<script>
    //@ts-nocheck
    const audio = document.getElementById("audio");
    const progress = document.getElementById("progress");
    const playButton = document.getElementById("play-button");
    const title = document.getElementById("current-title");

    document.querySelectorAll(".podcast")
    .forEach(item => {
        item.addEventListener("click", () => {
            audio.src = item.dataset.src;
            title.textContent = item.dataset.title;

            audio.play();
            playButton.textContent = "⏸";
        });
    });

    playButton.addEventListener("click", () => {
        if(audio.paused) {
            audio.play();
            playButton.textContent = "⏸";
        } else {
            audio.pause();
            playButton.textContent = "▶";
        }
    });

    audio.addEventListener("loadedmetadata", () => {
        progress.max = audio.duration;
    });

    audio.addEventListener("timeupdate", () => {
        progress.value = audio.currentTime;
    });

    progress.addEventListener("input", () => {
        audio.currentTime = progress.value;
    });

    audio.addEventListener("ended", () => {
        playButton.textContent = "▶";
    });

//Aantal afleveringen
document.addEventListener("DOMContentLoaded", () => {
    const podcastCount = document.getElementById("podcast-count");
    const podcasts = document.querySelectorAll(".podcast");

    console.log(podcasts.length);

    podcastCount.textContent = `${podcasts.length} afleveringen`;
})
</script>