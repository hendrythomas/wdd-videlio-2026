---
//@ts-nocheck
import MainLayout from '../../../../layouts/MainLayout.astro';
import audio1 from '../../../../../assets/audio/podcasts/';
import audio2 from '../../../../../assets/audio/podcasts/';
import audio3 from '../../../../../assets/audio/podcasts/';
---

<MainLayout>
    <section class="project-section">
        <h1>Podcasts/John Willemse</h1>
    </section>

    <section class="podcast-page">
        <div class="audio">
            <img src="../../assets/images/decoratie/niet_te_zien.png" class="main-img">

            <h4 id="current-title">1. Is dit creatief plannen, of toch gewoon uitstelgedrag?</h4>

            <audio id="audio"></audio>

            <div class="control-buttons">
                <button id="play-button">
                    ▶
                </button>

                <input type="range" value="0" id="progress">
            </div>
        </div>

        <div class="playlist-container">
            <h3 id="podcast-count"></h3>

            <div class="playlist">
                <div class="podcast" data-src={} data-title="Nr 1. Introductie podcast">
                    <h4>1. Is dit creatief plannen, of toch gewoon uitstelgedrag?</h4>

                    <button id="play-button">
                        ▶
                    </button>
                </div>

                <div class="podcast" data-src={} data-title="Nr 2. De samenleving heeft een handicap. Niet ik!">
                    <h4>2. Waarom fluiten bouwvakkers naar vrouwen en helpen ze mij?</h4>

                    <button id="play-button">
                        ▶
                    </button>
                </div>

                <div class="podcast" data-src={} data-title="Nr 3. De cijfers, achtergronden en oplossingen">
                    <h4>3. Labels en etiketten</h4>

                    <button id="play-button">
                        ▶
                    </button>
                </div>
            </div>
        </div>
    </section>
</MainLayout>

<style>
    .project-section {
        padding: 30px;
    }

    .podcast-page {
        display: flex;
        gap: 40px;
        padding: 30px;
    }

    .audio {
        width: 450px;
    }

    img {
        border-radius: 10px;
    }

    h4 {
        color: var(--highlight-color);
    }

    .main-img {
        width: 100%;
    }

    .control-buttons {
        margin-top: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .control-buttons button {
        border-radius: 50%;
        height: 40px;
        width: 40px;
        border: none;
        font-size: 18px;
    }

    #progress {
        flex: 1;
    }

    .playlist-container {
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    .playlist {
        overflow-y: scroll;
        height: 400px;
        padding: 10px;
    }

    .podcast {
        display: flex;
        justify-content: space-between;
        align-items: center;

        border: 2px solid gray;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 15px;
    }

    .podcast button {
        border-radius: 50%;
        border: none;
        height: 30px;
        width: 30px;
        font-size: 15px;
    }

    .podcast:hover {
        border-color: var(--highlight-color);
    }
</style>

<script>
    //@ts-nocheck
    const audio = document.getElementById("audio");
    const progress = document.getElementById("progress");
    const playButton = document.getElementById("play-button");
    const title = document.getElementById("current-title");

    document.querySelectorAll(".podcast")
    .forEach(item => {
        item.addEventListener("click", () => {
            audio.src = item.dataset.src;
            title.textContent = item.dataset.title;

            audio.play();
            playButton.textContent = "⏸";
        });
    });

    playButton.addEventListener("click", () => {
        if(audio.paused) {
            audio.play();
            playButton.textContent = "⏸";
        } else {
            audio.pause();
            playButton.textContent = "▶";
        }
    });

    audio.addEventListener("loadedmetadata", () => {
        progress.max = audio.duration;
    });

    audio.addEventListener("timeupdate", () => {
        progress.value = audio.currentTime;
    });

    progress.addEventListener("input", () => {
        audio.currentTime = progress.value;
    });

    audio.addEventListener("ended", () => {
        playButton.textContent = "▶";
    });

//Aantal afleveringen
document.addEventListener("DOMContentLoaded", () => {
    const podcastCount = document.getElementById("podcast-count");
    const podcasts = document.querySelectorAll(".podcast");

    console.log(podcasts.length);

    podcastCount.textContent = `${podcasts.length} afleveringen`;
})
</script>