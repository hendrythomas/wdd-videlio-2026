---
import './verhalen-media.css';
import MainLayout from "../../layouts/MainLayout.astro";
import ButtonLink from '../../components/ButtonLink/ButtonLink.astro';
---
<MainLayout pageTitle='Verhalen'>
    <section class="project-section">
        <h1>Verhalen & <strong>media</strong></h1>

        <main class="grid-projects">
            
            <article class="project-card">
                <ButtonLink href="/Verhalen-Media/Verhalen" class="project-card-link" aria-label="Lees of beluister verhalen van mede-VIPs">
                    <div class="project-card-img-wrap">
                        <img src="/assets/images/decoratie/verhalenVIPS.png" alt="">
                    </div>
                    <div class="info-projects">
                        <h2>Verhalen van VIPs</h2>
                        <p>Mensen met een visuele beperking die midden in het leven staan. In hun eigen woorden.</p>
                        <span class="info-projects-cta" aria-hidden="true">Bekijk alle verhalen van VIPS</span>
                    </div>
                </ButtonLink>
            </article>

            <article class="project-card">
                <a href="/Verhalen-Media/Podcasts" class="project-card-link" aria-label="Beluister podcasts van mede-VIPs">
                    <div class="project-card-img-wrap">
                        <img src="/assets/images/decoratie/podcast.png" alt="">
                    </div>
                    <div class="info-projects">
                        <h2>Podcasts</h2>
                        <p>uister naar VIPs die vertellen hoe zij de wereld ervaren.</p>

                </div>
            </div>

            <div class="project-card">
                <img src="assets/images/decoratie/podcast.png" alt="peter en patrick die ieder voor een microfoon zitten">

                <div class="info-projects">
                    <h2>Podcasts</h2>

                    <ButtonLink href="/Verhalen-Media/Podcasts" class="info-projects-link">Hoor meer</ButtonLink>
                </div>
            </div>

            <div class="project-card">
                <img src="assets/images/decoratie/rararadio.png" alt="peter meuleman die voor een microfoon staat">

                <div class="info-projects">
                    <h2>Radio</h2>

                    <ButtonLink href="/Verhalen-Media/Radio" class="info-projects-link">Hoor meer</ButtonLink>
                </div>
            </div>
                        <span class="info-projects-cta" aria-hidden="true">Bekijk alle podcasts</span>
                    </div>
                </a>
            </article>

            <article class="project-card">
                <a href="/Verhalen-Media/Radio" class="project-card-link" aria-label="Beluister uitgelichte radio uitzendingen van VIPS">
                    <div class="project-card-img-wrap">
                        <img src="/assets/images/decoratie/rararadio.png" alt="">
                    </div>
                    <div class="info-projects">
                        <h2>Radio</h2>
                        <p>Luister terug naar radio-uitzendingen van en voor mensen met een visuele beperking.</p>
                        <span class="info-projects-cta" aria-hidden="true">Beluister radio uitzendingen</span>
                    </div>
                </a>
            </article>
        </main>
    </section>
</MainLayout>
