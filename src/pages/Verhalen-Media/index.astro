---
import './verhalen-media.css';
import MainLayout from "../../layouts/MainLayout.astro";
---
<MainLayout>
    <section class="project-section">
        <h1>Verhalen & media</h1>

        <main class="grid-projects">
            <div class="project-card">
                <img src="../../../assets/images/decoratie/" alt="">

                <div class="info-projects">
                    <h2>Verhalen van VIPs</h2>

                    <a href="/Verhalen-Media/Verhalen" class="info-projects-link">Hoor meer</a>
                </div>
            </div>

            <div class="project-card">
                <img src="../../../assets/images/decoratie/podcast.png" alt="peter en patrick die ieder voor een microfoon zitten">

                <div class="info-projects">
                    <h2>Podcasts</h2>

                    <a href="/Verhalen-Media/Podcasts" class="info-projects-link">Hoor meer</a>
                </div>
            </div>

            <div class="project-card">
                <img src="../../../assets/images/decoratie/rararadio.png" alt="peter meuleman die voor een microfoon staat">

                <div class="info-projects">
                    <h2>Radio</h2>

                    <a href="/Verhalen-Media/Radio" class="info-projects-link">Hoor meer</a>
                </div>
            </div>
        </main>
    </section>
</MainLayout>