	---
	import MainLayout from '../layouts/MainLayout.astro';
	import ReadAloudButton from '../components/AccessibilityOptions/ReadAloudButton.astro';
	import './home.css';

	function decodeHtml(html: string): string {
	  return html
	    .replace(/&#8211;/g, 'â€“')
	    .replace(/&#8212;/g, 'â€”')
	    .replace(/&#8216;/g, 'â€˜')
	    .replace(/&#8217;/g, 'â€™')
	    .replace(/&#8220;/g, 'â€œ')
	    .replace(/&#8221;/g, 'â€')
	    .replace(/&amp;/g, '&')
	    .replace(/&quot;/g, '"')
	    .replace(/&lt;/g, '<')
	    .replace(/&gt;/g, '>');
	}

	let featuredActivity = null;

	try {
	  const res = await fetch(
	    'http://dev1.videlio.nl/wp-json/wp/v2/activities?per_page=100&_embed=true'
	  );
	  const activities = await res.json();
	  const now = new Date();

	  const upcoming = activities
	    .filter((activity: any) => {
	      const rawDate = activity.acf?.start_date_time;
	      if (!rawDate) return false;
	      return new Date(rawDate) >= now;
	    })
	    .sort((a: any, b: any) =>
	      new Date(a.acf.start_date_time).getTime() -
	      new Date(b.acf.start_date_time).getTime()
	    );

	  if (upcoming.length > 0) {
	    const activity = upcoming[0];

	    // Afbeelding: eerst ACF image veld, dan featured media
	    const image = activity.acf?.image?.url
	      ?? activity._embedded?.['wp:featuredmedia']?.[0]?.source_url
	      ?? null;

	    featuredActivity = {
	      title: decodeHtml(activity.title.rendered),
	      slug: activity.slug,
	      date: activity.acf.start_date_time,
	      image,
	      excerpt: activity.acf?.summary ?? '',
	      type: activity._embedded?.['acf:term']?.[0]?.name ?? '',
	    };
	  }
	} catch (e) {
	  console.warn('WordPress activiteiten niet bereikbaar');
	}

	const featuredDate = featuredActivity
	  ? new Date(featuredActivity.date).toLocaleString('nl-NL', {
	      weekday: 'long',
	      day: 'numeric',
	      month: 'long',
	      hour: '2-digit',
	      minute: '2-digit',
	    })
	  : null;
	---
	
	<MainLayout pageTitle="Doe mee!" title="Doe mee!">
		<!--Voor focus-indicator van anchor positioning-->
		<div class="focus-indicator"></div>

		<section class="hero">
			<h1 class="page-title"><strong>Samen</strong> anders zien  </h1>

			
				<div class="hero-body">
					<div class="hero-text" id="hero-intro">
						<ReadAloudButton variant="asymmetric" targetId="hero-intro" />

						<p>Je bent meer dan je blind- of slechtziendheid. Meer dan de wereld soms in jou denkt te zien.</p>
						<p>Een community <strong>voor, door en met VIPs (Visual Impaired Persons) </strong>, waarin je jezelf niet
							hoeft uit te leggen, maar juist ontdekt wat je te bieden hebt.</p>
						<p>Videlio. <br />
							Niet focussen op wat je mist, <strong>maar versterken wie je bent.</strong></p>
					</div>


					<article class="card card-featured hero-card">
						<a href={featuredActivity ? `/innovaties/${featuredActivity.slug}` : '/Doe-Mee!/Workshops'}
						   class="card-link"
						   aria-label={featuredActivity
						     ? `Uitgelichte activiteit: ${featuredActivity.title}. Bekijk meer`
						     : 'Bekijk alle workshops van Videlio'}>

							<!-- Afbeelding of placeholder -->
							{featuredActivity?.image ? (
								<img
									class="article-image"
									src={featuredActivity.image}
									alt={`Afbeelding bij ${featuredActivity.title}`} />
							) : (
								<svg class="article-image" viewBox="0 0 600 280" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Placeholder illustratie voor activiteit zonder afbeelding">
									<title>Activiteit placeholder</title>
									<rect width="600" height="280" rx="16" fill="#2F3742"/>
									<g transform="translate(160, 110)">
										<circle cx="0" cy="-30" r="18" fill="#FAEA07" opacity="0.9"/>
										<path d="M-22 0 Q-22 -20 0 -20 Q22 -20 22 0 L18 50 Q0 60 -18 50 Z" fill="#FAEA07" opacity="0.9"/>
									</g>
									<g transform="translate(260, 95)">
										<circle cx="0" cy="-35" r="22" fill="#FAEA07"/>
										<path d="M-26 0 Q-26 -24 0 -24 Q26 -24 26 0 L22 60 Q0 72 -22 60 Z" fill="#FAEA07"/>
									</g>
									<g transform="translate(360, 110)">
										<circle cx="0" cy="-30" r="18" fill="#FAEA07" opacity="0.9"/>
										<path d="M-22 0 Q-22 -20 0 -20 Q22 -20 22 0 L18 50 Q0 60 -18 50 Z" fill="#FAEA07" opacity="0.9"/>
									</g>
									<line x1="182" y1="150" x2="234" y2="155" stroke="rgba(250,234,7,0.35)" stroke-width="1.5" stroke-dasharray="4 3"/>
									<line x1="286" y1="155" x2="338" y2="150" stroke="rgba(250,234,7,0.35)" stroke-width="1.5" stroke-dasharray="4 3"/>
									<g transform="translate(430, 160)" opacity="0.5">
										<rect x="0" y="8" width="60" height="52" rx="6" fill="none" stroke="#FAEA07" stroke-width="1.5"/>
										<rect x="0" y="8" width="60" height="16" rx="6" fill="rgba(250,234,7,0.15)"/>
										<rect x="0" y="16" width="60" height="8" fill="rgba(250,234,7,0.15)"/>
										<line x1="16" y1="0" x2="16" y2="16" stroke="#FAEA07" stroke-width="2" stroke-linecap="round"/>
										<line x1="44" y1="0" x2="44" y2="16" stroke="#FAEA07" stroke-width="2" stroke-linecap="round"/>
										<rect x="8" y="32" width="10" height="8" rx="2" fill="rgba(250,234,7,0.4)"/>
										<rect x="25" y="32" width="10" height="8" rx="2" fill="rgba(250,234,7,0.2)"/>
										<rect x="42" y="32" width="10" height="8" rx="2" fill="rgba(250,234,7,0.2)"/>
										<rect x="8" y="46" width="10" height="8" rx="2" fill="rgba(250,234,7,0.2)"/>
										<rect x="25" y="46" width="10" height="8" rx="2" fill="rgba(250,234,7,0.4)"/>
									</g>
								</svg>
							)}
							<div class="card-label" aria-hidden="true">Uitgelicht</div>

							<div class="card-content hero-content">
								<h2 class="card-title">
									{featuredActivity?.title ?? 'Bekijk onze workshops'}
								</h2>
								<p class="card-text">
									{featuredActivity?.excerpt ?? 'Ontdek alle activiteiten en workshops van Videlio.'}
								</p>
								{featuredDate && (
									<div class="card-meta">
										<span aria-label="Datum en tijd">{featuredDate}</span>
										<span aria-label="Locatie">Eindhoven</span>
									</div>
								)}
							</div>
							<span class="card-btn" aria-hidden="true">
								{featuredActivity ? 'Bekijk activiteit' : 'Bekijk alle workshops'}
							</span>
						</a>
					</article>
				</div>
				

				
		</section>

		<div>
			<h2 class="h2-home"><strong>Ontdek meer:</strong></h2>

			<section class="grid" aria-label="Uitgelichte activiteiten">

				<!-- Article 1: Inlopen -->
				<a href="/About" class="card-link" aria-label="Meer informatie over inlopen bij Videlio">
				<article class="card">
					<img class="article-image" src="/assets/images/decoratie/loop-binnen.png" alt="" aria-hidden="true">
					<div class="card-content">
						<h2 class="card-title">Loop gerust binnen</h2>
						<p class="card-text">
							Geen afspraak nodig. Kom langs voor een kopje koffie, een gesprek,
							of gewoon om even bij andere VIPs te zijn. Je bent altijd welkom.
						</p>
						<span class="card-btn" aria-hidden="true">Kom langs</span>
					</div>
				</article>
				</a>


				<!-- Article 2: Verhalen van VIPs -->
				<a href="/Verhalen-Media/Verhalen" class="card-link" aria-label="Lees en beluister verhalen van VIPs">
				<article class="card">
					<img class="article-image" src="/assets/images/decoratie/viziere.jpg" alt="" aria-hidden="true">
					<div class="card-content">
						<h2 class="card-title">Verhalen van VIPs</h2>
						<p class="card-text">
							Elke VIP heeft een verhaal. Ontdek hoe mensen met een visuele
							beperking hun eigen weg vinden â€” in hun eigen woorden.
						</p>
						<span class="card-btn" aria-hidden="true">Bekijk verhalen</span>
					</div>
				</article>
				</a>


				<!-- Article 3: VIP Lab -->
				<a href="/Innovaties" class="card-link" aria-label="Meer weten over het VIP Lab">
				<article class="card">
					<img class="article-image" src="/assets/images/decoratie/lumicane2.png"
						alt="Man die s'nachts met een lichtgevende blindenstok loopt.">
					<div class="card-content">
						<h2 class="card-title">VIP Lab</h2>
						<p class="card-text">
							Innovatie door ervaringsdeskundigheid. In het VIP Lab werken we
							aan slimme oplossingen die het leven met een visuele beperking
							makkelijker en rijker maken.
						</p>
						<span class="card-btn" aria-hidden="true">Ontdek het lab</span>
					</div>
				</article>
				</a>

			</section>
	</MainLayout>
