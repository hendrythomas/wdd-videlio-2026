---
import ReadAloudButton from '../../components/AccessibilityOptions/ReadAloudButton.astro';
import ProgressiveDisclosure from '../../components/ProgressiveDisclosure/ProgressiveDisclosure.astro';
import ButtonLink from '../../components/ButtonLink/ButtonLink.astro';
import InnovatieCard from '../../components/Innovatie-li/Innovatie-li.astro';
import ViewToggle from '../../components/Innovatie-li/view-toggle.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { decodeHtml, stripHtml } from '../../utils/decodeHtml';
import './viplab.css';


interface Innovatie {
  id: string;
  slug: string;
  type: string;
  title: string;
  summary: string;
  image: string;
  imageAlt: string;
  tags: string[];
  date: string;
  detailPath: string;
}

let innovaties: Innovatie[] = [];

try {
  const res = await fetch('http://dev1.videlio.nl/wp-json/wp/v2/posts?per_page=100&_embed=true&categories=21');
  // categories=21 is de VIPLab categorie-id
  const wpPosts = await res.json();

  innovaties = wpPosts.map((post: any) => ({
    id: String(post.id),
    slug: post.slug,
    type: 'innovatie',
    title: decodeHtml(post.title.rendered),
    summary: stripHtml(post.excerpt.rendered),
    date: post.date,
    image: post._embedded?.['wp:featuredmedia']?.[0]?.source_url ?? '',
    imageAlt: decodeHtml(post.title.rendered),
    tags: post._embedded?.['wp:term']?.flat().map((t: any) => t.name) ?? [],
    detailPath: `/innovaties/${post.slug}`,
  }));
} catch (e) {
  console.warn('WordPress niet bereikbaar', e);
}
---

<MainLayout pageTitle="VIPLab" backHref="/">
  <section class="intro">
    <h1>VIPLab</h1>
    <p>
      VIPLab is de maakplek van Videlio.
      Samen met makers bouw je hier aan nieuwe hulpmiddelen en oplossingen.
    </p>
    <ProgressiveDisclosure title="Meer weten over de locatie?">
      <p>
        Videlio won in 2026 met VIPLab de <a href="https://burstyourbubble.nl">Burst Your Bubble pitchwedstrijd</a>.
        Hierdoor is er geld beschikbaar voor de eerste inrichting van VIPLab.
      </p>
      <p>
        VIPLab krijgt een plek in het <a href="../Contact#section-location">toekomstige ontmoetingscentrum</a> in Eindhoven.
      </p>
      <ProgressiveDisclosure title="Inrichting?">
        <p>
          Het bedrag gebruiken we voor de basis van de werkplek: stevige tafels, gereedschap, materialen, goed licht, vergrotingsmogelijkheden, een groot scherm, een 3D-printer en alles wat nodig is om snel te kunnen starten.
        </p>
        <ProgressiveDisclosure title="VIPLab steunen?">
          <p>Om VIPLab te steunen met materiaal, kennis, ruimte of sponsoring, kan je <a href="../Contact">contact opnemen met Videlio</a>.</p>
          <ButtonLink href="../Contact/Doneer">Geld doneren</ButtonLink>
        </ProgressiveDisclosure>
      </ProgressiveDisclosure>
    </ProgressiveDisclosure>
  </section>

  <section class="grid">
    <img src="../assets/images/decoratie/viplab.webp" alt="" loading="lazy">
    <div>
      <h2>Breng je uitdaging in</h2>
      <p>
        VIPs brengen een uitdaging in.
        Bijvoorbeeld: "Met hond, stok en tas kom ik handen tekort bij het inchecken."
      </p>
      <p>
        Videlio zoekt dan mensen die hierbij kunnen helpen.
        Samen maken, testen of verbeteren we een oplossing.
      </p>
      <ButtonLink href="#workshops">Ik wil meebouwen</ButtonLink>
    </div>
  </section>

  <section class="viplab-innovaties-section">
    <div class="viplab-innovaties-header">
      <h2>Innovaties</h2>
      <ViewToggle />
    </div>

    {innovaties.length > 0 ? (
      <ul class="innovaties-grid" id="viplab-innovaties-grid" data-view="grid" aria-label="Oplossingen gemaakt door VIPs">
        {innovaties.map(item => (
          <li>
            <InnovatieCard item={item} view="grid" />
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">Er zijn nog geen innovaties beschikbaar.</p>
    )}
  </section>

  <section>
    <h2 id="workshops">VIPLab-workshops</h2>
    <p>Insert workshops</p>
    <ButtonLink href="../Agenda">Alle workshops bekijken</ButtonLink>
  </section>
</MainLayout>

<script>
  const grid = document.getElementById('viplab-innovaties-grid');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.view-toggle-btn');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const view = btn.dataset.view as 'grid' | 'list';

      grid?.setAttribute('data-view', view);

      grid?.querySelectorAll<HTMLElement>('.innovatie-card').forEach(card => {
        card.className = `innovatie-card innovatie-card--${view}`;
      });

      buttons.forEach(b => {
        b.classList.toggle('view-toggle-btn--active', b === btn);
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
      });
    });
  });
</script>
