---
import ReadAloudButton from '../../components/AccessibilityOptions/ReadAloudButton.astro';
import ButtonLink from '../../components/ButtonLink/ButtonLink.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import './viplab.css';
---
<MainLayout pageTitle="VIPLab">
  <main>
    <section class="intro">
      <h1>VIPLab</h1>
      <p>
        VIPLab is de maakplek van Videlio.
        VIPs en makers bouwen hier samen aan hulpmiddelen en oplossingen voor mensen met een visuele beperking.
      </p>
      <p>
        VIPLab krijgt een plek in het toekomstige ontmoetingscentrum van Videlio in Eindhoven.
      </p>
    </section>
    <section class="grid">
      <img src="../assets/images/decoratie/lumicane2.png" alt="Man die in het donker op straat een lichtgevende blindenstok vasthoudt" loading="lazy">
      <div>
        <h2>Breng je uitdaging in</h2>
        <p>
          VIPs brengen een uitdaging in.
          Bijvoorbeeld: “Met hond, stok en tas kom ik handen tekort bij het inchecken.”
        </p>
        <p>
          VIPLab zoekt mensen die kunnen helpen.
          Samen maken, testen of verbeteren we een oplossing.
        </p>
        <ButtonLink href="#workshops">Ik wil meebouwen</ButtonLink>
      </div>
    </section>
    <section>
      <h2>Oplossingen gemaakt door andere VIPs</h2>
      <div class="carrousel">
        <div class="carrousel-item">
          <h3>LumiCane</h3>
          <p>LumiCane. <a href="../innovaties/lumicane">Meer lezen over lumicane</a></p>
        </div>
        <div class="carrousel-item">
          <h3>VibeCap</h3>
          <p>VibeCap</p>
        </div>
      </div>
    </section>
    <section>
      <h2 id="workshops">VIPLab-workshops</h2>
      <p>Insert workshops</p>
      <ButtonLink href="../Agenda">Zie alle workshops</ButtonLink>
    </section>
  </main>
</MainLayout>