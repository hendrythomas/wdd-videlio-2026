---
import MainLayout from '../../layouts/MainLayout.astro';
import innovaties from '../../data/innovations.json';

export function getStaticPaths() {
  return innovaties.map((item) => ({
    params: { detail: item.slug },
    props: { item },
  }));
}

const { item: propItem } = Astro.props;
const item = propItem ?? innovaties.find(i => i.slug === Astro.params.detail);

if (!item) return Astro.redirect('/innovaties');

const formattedDate = new Date(item.date).toLocaleDateString('nl-NL', {
  year: 'numeric',
  month: 'long',
});

const typeLabels: Record<string, string> = {
  project:   'Project',
  artikel:   'Artikel',
  onderzoek: 'Onderzoek',
};
---

<MainLayout>
  <article class="detail-page">

    <!-- Terug link -->
    <div class="detail-back-wrap">
      <a href="/innovaties" class="detail-back">← Terug naar overzicht</a>
    </div>

    <!-- Hero: afbeelding links, titel/meta rechts -->
    <div class="detail-hero">
      <div class="detail-hero-meta">
        <ul class="detail-tags">
          {item.tags.map(tag => <li>{tag}</li>)}
        </ul>
        <h1 class="detail-title">{item.title}</h1>
        <p class="detail-summary">{item.summary}</p>
        <time class="detail-date" datetime={item.date}>{formattedDate}</time>
      </div>

      <div class="detail-hero-img-wrap">
        <img
          src={item.image}
          alt={item.imageAlt}
          width="600"
          height="420"
        />
        <span class="detail-type-badge">{typeLabels[item.type] ?? item.type}</span>
      </div>
    </div>

    <!-- Inhoud -->
    <div class="detail-content" set:html={item.content} />

  </article>
</MainLayout>

<style>
  /* --- Pagina container  */
  .detail-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
    font-family: var(--primary-font), sans-serif;
  }

  /* --- Terug link  */
  .detail-back-wrap {
    margin-bottom: 2.5rem;
  }

  .detail-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--highlight-color);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    border: 1px solid rgba(250, 234, 7, 0.35);
    border-radius: 999px;
    padding: 0.45rem 1.1rem;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .detail-back:hover,
  .detail-back:focus-visible {
    background: var(--highlight-color);
    color: #1a1e24;
  }

  /* --- Hero grid: afbeelding links, tekst rechts  */
  .detail-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
    margin-bottom: 4rem;
  }

  /* --- Afbeelding  */
  .detail-hero-img-wrap {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(250, 234, 7, 0.2);
    aspect-ratio: 4 / 3;
  }

  .detail-hero-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* --- Type badge op de afbeelding  */
  .detail-type-badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    background: var(--highlight-color);
    color: #1a1e24;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;

    display: none;
  }

  /* --- Rechter kolom  */
  .detail-hero-meta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  /* --- Tags  */
  .detail-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .detail-tags li {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--highlight-color);
    border: 1px solid rgba(250, 234, 7, 0.35);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;

    display: none;
  }

  /* --- Titel  */
  .detail-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--primary-color);
    line-height: 1.15;
    margin: 0;
    position: relative;
    padding-left: 1.2rem;
  }

  .detail-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.1em;
    bottom: 0.1em;
    width: 5px;
    background: var(--highlight-color);
    border-radius: 0;
  }

  /* --- Samenvatting  */
  .detail-summary {
    font-size: 1.05rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    border-left: 2px solid rgba(250, 234, 7, 0.25);
    padding-left: 1rem;
  }

  /* --- Datum  */
  .detail-date {
    font-size: 1.25rem;
    color: var(--highlight-color);
    display: block;
  }

  /* --- Content body  */
  .detail-content {
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Ruimte tussen alinea's */
  .detail-content :global(p) {
    margin-bottom: 1.75rem;
  }

  /* Vetgedrukte koppen in de HTML content */
  .detail-content :global(strong) {
    /* color: var(--primary-color); */
    font-weight: 700;
  }

  /* Eventuele tussenkopjes */
  .detail-content :global(h2),
  .detail-content :global(h3) {
    color: var(--highlight-color);
    margin: 2.5rem 0 1rem;
    line-height: 1.2;
  }

  /* Links in content */
  .detail-content :global(a) {
    color: var(--highlight-color);
    text-underline-offset: 3px;
  }

  /* --- Responsive: onder elkaar op mobiel  */
  @media (max-width: 700px) {
    .detail-hero {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .detail-hero-img-wrap {
      aspect-ratio: 16 / 9;
    }
  }
</style>