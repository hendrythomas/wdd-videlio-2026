---
import MainLayout from '../../layouts/MainLayout.astro';
import InnovatieCard from '../../components/Innovatie-li/Innovatie-li.astro';
import ViewToggle from '../../components/Innovatie-li/view-toggle.astro'
import indexCSS from "../../style/index.css";

import './innovaties.css';

// Probeer eerst WordPress, val terug op lokale data
interface Innovatie {
  id: string;
  slug: string;
  type: string;
  title: string;
  summary: string;
  image: string;
  imageAlt: string;
  tags: string[];
  date: string;
  detailPath: string;
}

let innovaties: Innovatie[] = [];

try {
  const res = await fetch('http://dev1.videlio.nl/wp-json/wp/v2/posts?per_page=100&_embed=true');
  const wpPosts = await res.json();

  innovaties = wpPosts.map((post: any) => ({
    id: String(post.id),
    slug: post.slug,
    type: 'innovatie',
    title: post.title.rendered,
    summary: post.excerpt.rendered.replace(/<[^>]*>/g, '').trim(),
    date: post.date,
    image: post._embedded?.['wp:featuredmedia']?.[0]?.source_url ?? '',
    imageAlt: post.title.rendered,
    tags: post._embedded?.['wp:term']?.flat().map((t: any) => t.name) ?? [],
    detailPath: `/innovaties/${post.slug}`,
  }));
} catch {
  // Fallback naar lokale JSON
  const local = await import('../../data/innovations.json');
  innovaties = local.default;
}
---

<MainLayout pageTitle="Innovaties" backHref="/">

      <!--Voor focus-indicator van anchor positioning-->
			<div class="focus-indicator"></div>

  <section class="innovaties-section">

    <div class="innovaties-header">
      <h1 class="innovaties-title">Innovaties</h1>
      <p class="innovaties-intro">
        Uitgelichte ontwikkelingen in toegankelijkheid, ... & ...
      </p>

      <ViewToggle />
    </div>

    <!-- Kaarten grid/list -->
    <ul class="innovaties-grid" id="innovaties-grid" data-view="grid" aria-label="Overzicht innovaties">
      {innovaties.map(item => (
        <li>
          <InnovatieCard item={item} view="grid" />
        </li>
      ))}
    </ul>

  </section>
</MainLayout>

<script>
  const grid = document.getElementById('innovaties-grid');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.view-toggle-btn');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const view = btn.dataset.view as 'grid' | 'list';

      // Update grid data attribute (CSS reageert hierop)
      grid?.setAttribute('data-view', view);

      // Update kaarten data-view attribuut
      grid?.querySelectorAll<HTMLElement>('.innovatie-card').forEach(card => {
        card.className = `innovatie-card innovatie-card--${view}`;
      });

      // Toggle active state buttons
      buttons.forEach(b => {
        b.classList.toggle('view-toggle-btn--active', b === btn);
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
      });
    });
  });
</script>