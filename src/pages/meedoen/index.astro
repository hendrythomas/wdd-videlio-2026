---
//@ts-nocheck
import MainLayout from '../../layouts/MainLayout.astro';
import { fetchCategoryContent, sectionMeta } from '../../utils/fetchCategoryContent';
import './meedoen.css';

const data = await fetchCategoryContent();

const sections = Object.entries(sectionMeta).map(([key, meta]) => ({
  ...meta,
  key,
  featured: data[key].activities[0] ?? null,
}));
---
<MainLayout pageTitle="Doe mee">
  <section class="intro">
    <h1>Doe mee</h1>
    <p>Ontdek de verschillende manieren waarop je bij Videlio kunt meedoen.</p>
  </section>

  <section class="category-grid">
    {sections.map(s => (
      <a href={s.href} class="category-tile">
        <h2>{s.title}</h2>
        {s.featured ? (
          <p class="category-tile-preview">{s.featured.title}</p>
        ) : (
          <p class="category-tile-preview category-tile-preview--empty">Nog geen activiteiten gepland</p>
        )}
      </a>
    ))}
  </section>
</MainLayout>
