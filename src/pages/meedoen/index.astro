    <p>
      [Vervang dit] VIPLab is de maakplek van Videlio.
      Samen met makers bouw je hier aan nieuwe hulpmiddelen en oplossingen.
    </p>
  </section>
  <section>
    <h2 id="gemeenschap">Videlio Community</h2>
    <h3>WhatsApp-groep</h3>
  </section>
  <section>
    <h2 id="toegankelijkheid">Fysieke toegankelijkheid</h2>
    <h3>OV-Knoop</h3>
  </section>
  <section>
    <h2 id="groei">Persoonlijke groei</h2>
    <h3>Viziere</h3>
  </section>
</MainLayout>