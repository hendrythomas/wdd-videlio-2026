---
import MainLayout from '../../../layouts/MainLayout.astro';

import './workshops.css';
---

<MainLayout>
    <main id="main-workshops-content">
        <div class="heading">
            <h1>Workshops</h1>
            <a href="../">Terug</a>
        </div>
        <div class="button-list">
            <button id="toggle-workshops" class="button">Ontdek onze workshops</button>
            <button id="toggle-offer" class="button">
                Biedt een workshop aan
            </button>
        </div>
        <section aria-live="polite" id="workshops-list" class="workshop-content hidden">
            <div class="workshop-card">
                <div class="info">
                    <h2 class="workshop-header">Workshop: Doen!</h2>
                    <p>Meer informatie over deze workshop..</p>
                </div>
                <a class="button" href="#">Doe mee aan deze workshop!</a>
            </div>
            <div class="workshop-card">
                <h2 class="workshop-header">Workshop: Stok & Stekker</h2>
                <p>Meer informatie over deze workshop..</p>
                <a class="button" href="#">Doe mee aan deze workshop!</a>
            </div>
            <div class="workshop-card">
                <h2 class="workshop-header">Workshop: Je kunt leven als kunstwerk</h2>
                <p>Meer informatie over deze workshop..</p>
                <a class="button" href="#">Doe mee aan deze workshop!</a>
            </div>
        </section>
        <section aria-live="polite" id="offer-workshop-form" class="workshop-content hidden">
            <!-- <h2>Vertel ons jouw ideeën</h2>
            <form>
                <label>Naam <input name="name" type="text"></label>
                <label>E-mailadres <input name="email" type="email"></label>
                <label>Jouw bericht<textarea rows="4" name="message"></textarea></label>
                <button class="button">Verstuur</button>
            </form> -->
            <div>
                <h2>Wij willen jouw mening!</h2>
                <p>Mocht je ideeën of suggesties hebben over het houden van een workshop, laat het ons weten! Wij staan hier altijd voor open.</p>
            </div>
            <!-- Lid 1 – John Willemse -->
            <li class="board-card" aria-label="Bestuurslid John Willemse, Voorzitter">
                <div class="board-card__photo-container">
                    <img class="board-card__photo" src="../astro-temp/assets/images/members/JohnWillemse.png"
                         alt="Portretfoto van John Willemse" width="110" height="110" />
                </div>
                <div class="board-card__identity">
                    <h3 class="board-card__name">John Willemse</h3>
                    <p class="board-card__role">Voorzitter</p>
                </div>
                <a class="board-card__btn" href="mailto:john@videlio.nl"
                   aria-label="Stuur een e-mail naar John Willemse">Stuur John een E-mail</a>
            </li>
        </section>
    </main>
</MainLayout>