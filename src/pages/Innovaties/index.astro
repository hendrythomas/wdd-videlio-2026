---
import MainLayout from '../../layouts/MainLayout.astro';
import ButtonLink from '../../components/ButtonLink/ButtonLink.astro';

import './innovaties.css';
---

<MainLayout>
    <section class="project-section">
        <h1>Projecten</h1>

        <main class="grid-projects">
            <div class="project-card">
                <img src="/assets/images/decoratie/lumicane2.png" alt="man die in het donker op straat een lichtgevende blindenstok vasthoudt">

                <div class="info-projects">
                    <h2>LumiCane</h2>

                    <p>Lichtgevende stok.........</p>

                    <ButtonLink href="/Innovaties/Lumicane" class="info-projects-link">Lees meer</ButtonLink>
                </div>
            </div>


            <div class="project-card">
                <img src="/assets/images/decoratie/viziere.jpg" alt="een meisje dat braille leest">

                <div class="info-projects">
                    <h2>Project Viziere</h2>

                    <p>basic!pakket zo iets.........</p>

                    <ButtonLink href="/Innovaties/Viziere" class="info-projects-link">Lees meer</ButtonLink>
                </div>
            </div>


            <div class="project-card">
                <img src="/assets/images/decoratie/ov_knoop.jpg" alt="het gebouw De Bubble in het centrum van Eindhoven, met daarnaast het kantoorgebouw van Philips">

                <div class="info-projects">
                    <h2>OV Knoop Eindhoven</h2>

                    <p>eindhoven ov herbouwen.......</p>

                    <ButtonLink href="/Innovaties/OV-knoop" class="info-projects-link">Lees meer</ButtonLink>
                </div>
            </div>
        </main>
    </section>
</MainLayout>