---
import Header from '../components/Header/Header.astro';
import Footer from '../components/Footer/Footer.astro';
import ButtonLink from '../components/ButtonLink/ButtonLink.astro';

const { pageTitle, backHref } = Astro.props;

import '../style/index.css';
import './mainLayout.css';
---

<html lang="nl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="../assets/images/branding/favicon.webp">
    <title>{pageTitle ? `${pageTitle} | Videlio` : 'Videlio'}</title>
</head>

<body>
    <Header />
    { backHref && <ButtonLink linkClass="main-layout-back-button" href={backHref}>← Terug</ButtonLink> }
    <div class="page">
        <slot />
    </div>
    <Footer />
</body>

</html>
