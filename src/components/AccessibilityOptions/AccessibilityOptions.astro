---
import './accessibilityOptions.css';
import '../../style/icons.css';
---

<button class="access-button" popovertarget="access-menu">
  <i class="material-icon" aria-hidden="true"></i>
  <span class="desktop">Toegankelijkheid</span>
</button>
<div class="access-menu" popover id="access-menu">
  <div class="access-item">
    <h2>Toegankelijkheid</h2>
    <button class="button" title="Menu sluiten" popovertarget="access-menu" popovertargetaction="hide">
      <i class="material-icon" aria-hidden="true">close</i>
    </button>
  </div>
  <div class="access-item">
    <span>Lettertype</span>
    <button title="Verkleinen" id="setting-decrease-font">
      <i class="material-icon" aria-hidden="true">remove</i>
    </button>
    <button title="Vergroten" id="setting-increase-font">
      <i class="material-icon" aria-hidden="true">add</i>
    </button>
  </div>
  <div class="access-item">
    <span>Contrastthema gebruiken</span>
    <label data-title="Aanzetten" data-checked-title="Uitzetten">
      <i class="material-icon" aria-hidden="true"></i>
      <input type="checkbox" id="setting-high-contrast">
    </label>
  </div>
  <div class="access-item">
    <span>Muisaanwijzer vergroten</span>
    <label data-title="Aanzetten" data-checked-title="Uitzetten">
      <i class="material-icon" aria-hidden="true"></i>
      <input type="checkbox" id="setting-big-cursor">
    </label>
  </div>
</div>

<script is:inline>

  let addedFontSize = 0;

  document.addEventListener('DOMContentLoaded', (e) => {
    updateSettings();
    updateTooltips();
  });

  document.addEventListener('change', (e) => {
    updateSettings(e.target);
    updateTooltips();
  });

  document.addEventListener('click', (e) => {
    updateSettings(e.target);
  });

  function updateSettings(elem = null) {
    tryToggleBigCursor(elem);
    tryToggleContrastTheme(elem);
    tryIncreaseFontSize(elem);
    tryDecreaseFontSize(elem);
  }

  function updateTooltips() {
    const tooltipLabels = document.querySelectorAll('[data-title][data-checked-title]');
    
    for (const label of tooltipLabels || []) {
      const input = label.querySelector('input');
      if (input.checked) {
        label.title = label.dataset.checkedTitle;
      } else {
        label.title = label.dataset.title;
      }
    }
  }

  function tryToggleBigCursor(elem) {
  }

  function tryToggleContrastTheme(elem) {
    let input = elem;
    if (elem === null) {
      input = document.getElementById('setting-high-contrast');
      if (input === null) return;
    }
    if (input.id !== 'setting-high-contrast') return;
    
    if (input.checked) {
      document.documentElement.classList.add('high-contrast');
    } else {
      document.documentElement.classList.remove('high-contrast');
    }
  }

  function tryIncreaseFontSize(button) {
    if (button === null || button.id !== 'setting-increase-font') return;
    addedFontSize += 1;
    updateDocumentFontSize();
  }

function tryDecreaseFontSize(button) {
  if (button === null || button.id !== 'setting-decrease-font') return;
  addedFontSize -= 1;
  if (addedFontSize < 0) addedFontSize = 0;
  updateDocumentFontSize();
}

  function updateDocumentFontSize() {
    document.documentElement.style.fontSize = `calc(1rem + ${addedFontSize}px)`;
  }

</script>