---
//@ts-nocheck
import ButtonLink from '../../../ButtonLink/ButtonLink.astro';
import ProgressiveDisclosure from '../../../ProgressiveDisclosure/ProgressiveDisclosure.astro';

import './eventItem.css';

const { event } = Astro.props;

const startDateOptions = {
    day: 'numeric',
    month: 'long',
    hour: '2-digit',
    minute: '2-digit',
};

const startDate = new Date(event.startDate);
const mailHref = `mailto:john@videlio.nl?subject=Aanmelding%20${event.title}`

---

<section class="event-item">
    {
        event.image && <img class="event-item__image" src={event.image.url} alt={event.image.alt} />
    }
    <div class="event-item__main-info">
        <div class="event-item__header">
            <h3 class="event-item__title">{event.title}</h3>
            <div class="event-item__types">
                {event.types.map(type => (
                        <span class="event-item__card-tag">{type}</span>
                ))}
            </div>
        </div>
    </div>
    <div class="event-item__summary">
        <p>
            {event.summary}
        </p>
        {
            event.longDescription && (
                <ProgressiveDisclosure title="Lees meer" id={event.id} className="event-item__details">
                    <div set:html={event.longDescription} />
                </ProgressiveDisclosure>
            )
        }
        <div class="event-item__extra-info">
            <span class="event-item__time">
                <span>{startDate.toLocaleString('nl-NL', startDateOptions)}</span>
                { event.endTime && (
                        <span>{`- ${event.endTime}`}</span>
                )}
            </span>
            <span class="event-item__location">
                Bomanshof 147 5611 NR Eindhoven
            </span>

            <ButtonLink linkClass='event-item__button' href={mailHref}>Mail om je aan te melden</ButtonLink>
        </div>
    </div>
</section>
