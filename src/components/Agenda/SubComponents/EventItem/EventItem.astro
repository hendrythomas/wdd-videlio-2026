---
//@ts-nocheck
import Button from '../../../Button/Button.astro';

import './eventItem.css';

const { event } = Astro.props;

const startDate = new Date(event.startDate);
const endDate = new Date(event.endDate);
const startDateOptions = {
    day: 'numeric',
    month: 'long',
    hour: '2-digit',
    minute: '2-digit',
};
let endDateOptions = {
    hour: '2-digit',
    minute: '2-digit',
}
if (endDate.getDate() !== startDate.getDate()) {
    endDateOptions = startDateOptions;
}

---

<section class="event-item">
    <div class="event-item__main-info">
        <div class="event-item__header">
            <h3 class="event-item__title">{event.title}</h3>
            <span class="event-item__card-tag">{`${event.type}`}</span>
        </div>
    </div>
    <div class="event-item__summary">
        <p>
            {event.summary}
        </p>
        {
            event.longDescription && (
                <details class="event-item__details">
                    <summary>Lees meer</summary>
                    {event.longDescription}
                </details>
            )
        }
        <div class="event-item__extra-info">
            <span class="event-item__time">
                <span>{startDate.toLocaleString('nl-NL', startDateOptions)}</span>
                { event.endDate && (
                        <span>{`- ${endDate.toLocaleTimeString('nl-NL', endDateOptions)}`}</span>
                )}
            </span>
            <span class="event-item__location">
                Bomanshof 147 <br/> 5611 NR Eindhoven
            </span>
            <Button buttonClass='event-item__button'>Meld je aan</Button>
        </div>
    </div>
</section>
