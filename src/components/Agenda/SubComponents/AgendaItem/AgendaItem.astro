---
//@ts-nocheck
import EventItem from "../EventItem/EventItem.astro";
import './agendaItem.css';

const { events } = Astro.props;

if (!events?.length) return;

const date = new Date(events[0].startDate);
const dayString = date.toLocaleString('nl-NL', { weekday: 'long' });
const capitalizedDay = dayString.charAt(0).toUpperCase() + dayString.slice(1);
const day = date.getDate();
const month = date.toLocaleString('nl-NL', { month: 'long' });
---

<section class="agenda-item">
        <h2 class="agenda-item__date">
            {`${capitalizedDay} ${day} ${month}`}
        </h2>
    {
        events.map((event) => <EventItem event={event} />)
    }
</section>
