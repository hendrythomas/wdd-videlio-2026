---
//@ts-nocheck
import AgendaItem from './SubComponents/AgendaItem/AgendaItem.astro';

import './agenda.css';

const fetchSessions = async () => {
    const res = await fetch('http://dev1.videlio.nl/wp-json/wp/v2/activities?&acf_format=standard');
    const data = await res.json();

    return data.map(session => {
        const [day, month, year] = session.acf.start_date.split('/');
        const startDate = `${year}-${month}-${day}T${session.acf.start_time || '00:00'}`;

        return {
            id: session.id,
            title: session.title.rendered,
            summary: session.acf.summary,
            longDescription: session.acf.long_description,
            startDate,
            endTime: session.acf.end_time || null,
            image: session.acf.image ? session.acf.image.url : null,
            types: Array.isArray(session.acf.type) ? session.acf.type.map(t => t.name) : [],
        };
    });
};

const events = await fetchSessions();
const groupEventsByDateTime = (events) => {
    const grouped = {};
    for (const event of events) {
        if (new Date(event.startDate) > new Date()) {
            const dateKey = new Date(event.startDate).toISOString().split('T')[0];
            if (!grouped[dateKey]) {
                grouped[dateKey] = [];
            }
            grouped[dateKey].push(event);
        }
    }

    const groupedEventsArray = Object.values(grouped);
    return groupedEventsArray
        .sort((a, b) => new Date(a[0].startDate) - new Date(b[0].startDate))
        .map(dayEvents =>
            dayEvents.sort((a, b) => new Date(a.startDate) - new Date(b.startDate))
        );
};

const sortedEvents = groupEventsByDateTime(events);
---

<div class="agenda">
    {
        sortedEvents.map(dayEvents => {
            return (
                <AgendaItem events={dayEvents} />
            )
        })
    }
</div>