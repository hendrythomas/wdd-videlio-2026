---
import './nav.css';
import Link from '../Link/Link.astro';
import Search from '../AccessibilityOptions/SearchBar.astro';


const currentPath = Astro.url.pathname;
---

<nav class="navigation" aria-label="Navigatie menu">
    <a class="logo" href="../" aria-label="Terug naar Home pagina">
        <img src="../assets/images/branding/logo_yellow.svg" alt="">
    </a>
    <label class="hamburger" aria-label="Open navigatie">
        <i class="material-icon" aria-hidden="true"></i>
        <input type="checkbox">
    </label>
    <div class="mobile-menu">
        <Link isActive={currentPath === '/' || currentPath.includes('/Doe-Mee!')} href="../">Doe mee</Link>
        <Link isActive={currentPath.includes('/Agenda')} href="/Agenda">Agenda</Link>
        <Link isActive={currentPath.includes('/Verhalen-Media')} href="/Verhalen-Media">Verhalen</Link>
        <Link isActive={currentPath.includes('/innovaties')} href="/innovaties">Innovaties</Link>
        <Link isActive={currentPath.includes('/Contact')} href="/Contact">Contact</Link>
    </div>

    <Search />
</nav>