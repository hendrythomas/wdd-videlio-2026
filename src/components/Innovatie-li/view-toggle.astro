<!-- View toggle -->
      <div class="view-toggle" role="group" aria-label="Weergave kiezen">
        <button
          class="view-toggle-btn view-toggle-btn--active"
          id="btn-grid"
          aria-pressed="true"
          aria-label="Gridweergave"
          data-view="grid"
        >
          <!-- Grid icon -->
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect x="1" y="1" width="7" height="7" rx="1.5" fill="currentColor"/>
            <rect x="12" y="1" width="7" height="7" rx="1.5" fill="currentColor"/>
            <rect x="1" y="12" width="7" height="7" rx="1.5" fill="currentColor"/>
            <rect x="12" y="12" width="7" height="7" rx="1.5" fill="currentColor"/>
          </svg>
          Grid
        </button>
        <button
          class="view-toggle-btn"
          id="btn-list"
          aria-pressed="false"
          aria-label="Lijstweergave"
          data-view="list"
        >
          <!-- List icon -->
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect x="1" y="2" width="18" height="3" rx="1.5" fill="currentColor"/>
            <rect x="1" y="8.5" width="18" height="3" rx="1.5" fill="currentColor"/>
            <rect x="1" y="15" width="18" height="3" rx="1.5" fill="currentColor"/>
          </svg>
          Lijst
        </button>
      </div>
      